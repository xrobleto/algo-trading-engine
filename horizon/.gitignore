# Secrets — never commit
.env
*.env

# The repo-root .gitignore ignores every data/ directory. Re-include the
# Horizon data-layer source code, but keep the regenerated price cache out.
!data/
data/cache/

# Backtest outputs
results/*
!results/.gitkeep

# Python
__pycache__/
*.pyc
.pytest_cache/

# Runtime state (ledger, engine_state) — never commit.
state/

# The repo-root .gitignore blanket-ignores *.json; re-include the Railway
# deploy config (this is the only .json Horizon needs in version control).
!railway.json

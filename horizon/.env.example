# Horizon Engine — secrets. Copy to horizon/.env and fill in.
# horizon/.env is gitignored and must never be committed.

# Polygon.io — market data (daily aggregates, dividends, indices)
POLYGON_API_KEY=

# Alpaca — broker. Paper keys for testing; live keys only when intentionally live.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Live-trading guards — Horizon refuses live unless BOTH are set explicitly.
LIVE_TRADING=0
I_UNDERSTAND_LIVE_TRADING=
